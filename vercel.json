{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(assets|fontes|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/casamentos", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
